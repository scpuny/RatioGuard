{
  "description": "静态自检禁用模式：键鼠控制 / OCR / 券商下单相关标识符与交易端点。仅扫描 tokenize 后的 NAME 与 STRING 词法单元，跳过注释与文档，避免误报 SOP 说明文字。",
  "name_patterns": [
    "pyautogui",
    "pynput",
    "pywinauto",
    "autoit",
    "xdotool",
    "sendkeys",
    "keybd_event",
    "mouse_event",
    "easyocr",
    "pytesseract",
    "tesseract",
    "ocr_engine",
    "selenium",
    "playwright",
    "uiautomation",
    "easytrader",
    "joinquant",
    "rqalpha",
    "tqsdk",
    "xtquant",
    "vnpy",
    "place_order",
    "submit_order",
    "cancel_order",
    "send_order",
    "execute_order",
    "order_buy",
    "order_sell",
    "buy_stock",
    "sell_stock",
    "auto_trade",
    "place_trade",
    "typewrite",
    "hotkey",
    "screenshot",
    "screencapture",
    "doubleclick",
    "^keyboard$",
    "^mouse$",
    "^click$",
    "^moveto$",
    "^press$"
  ],
  "string_patterns": [
    "/api/order",
    "/trade/order",
    "place_order\\(",
    "submit_order\\("
  ],
  "exclude_dirs": ["tests", "tools", "skills", "deploy", "templates", "reports", "data", ".workbuddy", "__pycache__", ".git"],
  "exclude_files": ["static_scan.py"]
}

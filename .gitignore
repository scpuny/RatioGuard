# ---- 密钥与本地环境配置（示例文件保留）----
deploy/qsignal.env
*.env.local
.env

# ---- WorkBuddy 本地项目数据 / 私人笔记（不删除，仅不纳入版本库）----
.workbuddy/

# ---- 编辑器与操作系统 ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

